--- /dev/null
+++ b/submodules/NightGram/Sources/NightGramLocalGiftStore.swift
@@ -0,0 +1,185 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+/// A gift that exists only in this account's local Postbox.
+/// It is not a Telegram StarGift and is never sent to another device.
+public struct NightGramLocalGift: Codable, Equatable, Identifiable {
+    public let id: Int64
+    public let title: String
+    public let symbol: String
+    public let price: Int64
+    public let createdAt: Int32
+    public let isReceived: Bool
+    public var isPinned: Bool
+    public var isHidden: Bool
+    public var soldAt: Int32?
+
+    public init(
+        id: Int64 = Int64.random(in: 1...Int64.max),
+        title: String,
+        symbol: String,
+        price: Int64,
+        createdAt: Int32 = Int32(Date().timeIntervalSince1970),
+        isReceived: Bool = false,
+        isPinned: Bool = false,
+        isHidden: Bool = false,
+        soldAt: Int32? = nil
+    ) {
+        self.id = id
+        self.title = title
+        self.symbol = symbol
+        self.price = max(0, price)
+        self.createdAt = createdAt
+        self.isReceived = isReceived
+        self.isPinned = isPinned
+        self.isHidden = isHidden
+        self.soldAt = soldAt
+    }
+}
+
+public struct NightGramLocalGiftOperation: Codable, Equatable, Identifiable {
+    public let id: Int64
+    public let kind: String
+    public let amount: Int64
+    public let title: String
+    public let balanceAfter: Int64
+    public let createdAt: Int32
+
+    public init(id: Int64 = Int64.random(in: 1...Int64.max), kind: String, amount: Int64, title: String, balanceAfter: Int64, createdAt: Int32 = Int32(Date().timeIntervalSince1970)) {
+        self.id = id
+        self.kind = kind
+        self.amount = amount
+        self.title = title
+        self.balanceAfter = balanceAfter
+        self.createdAt = createdAt
+    }
+}
+
+public struct NightGramLocalGiftState: Codable, Equatable {
+    public var gifts: [NightGramLocalGift]
+    public var fakeStarsBalance: Int64
+    public var fakeTonBalanceNanos: Int64
+    public var operations: [NightGramLocalGiftOperation]
+
+    public init(gifts: [NightGramLocalGift] = [], fakeStarsBalance: Int64 = 50_000, fakeTonBalanceNanos: Int64 = 0, operations: [NightGramLocalGiftOperation] = []) {
+        self.gifts = gifts
+        self.fakeStarsBalance = fakeStarsBalance
+        self.fakeTonBalanceNanos = fakeTonBalanceNanos
+        self.operations = operations
+    }
+}
+
+/// Postbox-backed storage, following PampGram's PreferencesEntry pattern.
+/// The key is reserved for NightGram and is separate from Telegram's real gift/balance keys.
+public enum NightGramLocalGiftStore {
+    private static let storageKey: ValueBoxKey = {
+        let key = ValueBoxKey(length: 4)
+        key.setInt32(0, value: 910_100)
+        return key
+    }()
+
+    public static func stateSignal(postbox: Postbox) -> Signal<NightGramLocalGiftState, NoError> {
+        return postbox.preferencesView(keys: [storageKey])
+        |> map { view in
+            return view.values[storageKey]?.get(NightGramLocalGiftState.self) ?? NightGramLocalGiftState()
+        }
+        |> distinctUntilChanged
+    }
+
+    @discardableResult
+    public static func addDemoGift(postbox: Postbox, title: String, symbol: String, price: Int64 = 100, received: Bool) -> Signal<Bool, NoError> {
+        return postbox.transaction { transaction -> Bool in
+            var state = transaction.getPreferencesEntry(key: storageKey)?.get(NightGramLocalGiftState.self) ?? NightGramLocalGiftState()
+            guard price > 0 else {
+                return false
+            }
+
+            let updatedBalance: Int64
+            if received {
+                let result = state.fakeStarsBalance.addingReportingOverflow(price)
+                guard !result.overflow else {
+                    return false
+                }
+                updatedBalance = result.partialValue
+            } else {
+                guard state.fakeStarsBalance >= price else {
+                    return false
+                }
+                updatedBalance = state.fakeStarsBalance - price
+            }
+
+            let gift = NightGramLocalGift(title: title, symbol: symbol, price: price, isReceived: received)
+            state.gifts.append(gift)
+            state.fakeStarsBalance = updatedBalance
+            state.operations.insert(
+                NightGramLocalGiftOperation(
+                    kind: received ? "demoReceived" : "demoPurchase",
+                    amount: received ? price : -price,
+                    title: received ? "Демо-подарок мне" : "Демо-покупка подарка",
+                    balanceAfter: updatedBalance
+                ),
+                at: 0
+            )
+            if state.operations.count > 500 {
+                state.operations = Array(state.operations.prefix(500))
+            }
+            transaction.updatePreferencesEntry(key: storageKey, { _ in
+                return PreferencesEntry(state)
+            })
+            return true
+        }
+    }
+
+    @discardableResult
+    public static func setPinned(postbox: Postbox, id: Int64, pinned: Bool) -> Signal<Bool, NoError> {
+        return postbox.transaction { transaction -> Bool in
+            var state = transaction.getPreferencesEntry(key: storageKey)?.get(NightGramLocalGiftState.self) ?? NightGramLocalGiftState()
+            guard let index = state.gifts.firstIndex(where: { $0.id == id && $0.soldAt == nil }) else {
+                return false
+            }
+            state.gifts[index].isPinned = pinned
+            transaction.updatePreferencesEntry(key: storageKey, { _ in PreferencesEntry(state) })
+            return true
+        }
+    }
+
+    @discardableResult
+    public static func setHidden(postbox: Postbox, id: Int64, hidden: Bool) -> Signal<Bool, NoError> {
+        return postbox.transaction { transaction -> Bool in
+            var state = transaction.getPreferencesEntry(key: storageKey)?.get(NightGramLocalGiftState.self) ?? NightGramLocalGiftState()
+            guard let index = state.gifts.firstIndex(where: { $0.id == id && $0.soldAt == nil }) else {
+                return false
+            }
+            state.gifts[index].isHidden = hidden
+            transaction.updatePreferencesEntry(key: storageKey, { _ in PreferencesEntry(state) })
+            return true
+        }
+    }
+
+    @discardableResult
+    public static func sellDemoGift(postbox: Postbox, id: Int64) -> Signal<Bool, NoError> {
+        return postbox.transaction { transaction -> Bool in
+            var state = transaction.getPreferencesEntry(key: storageKey)?.get(NightGramLocalGiftState.self) ?? NightGramLocalGiftState()
+            guard let index = state.gifts.firstIndex(where: { $0.id == id && $0.soldAt == nil }) else {
+                return false
+            }
+            let gift = state.gifts[index]
+            let result = state.fakeStarsBalance.addingReportingOverflow(gift.price)
+            guard !result.overflow else {
+                return false
+            }
+            state.fakeStarsBalance = result.partialValue
+            state.gifts[index].soldAt = Int32(Date().timeIntervalSince1970)
+            state.gifts[index].isHidden = true
+            state.gifts[index].isPinned = false
+            state.operations.insert(
+                NightGramLocalGiftOperation(kind: "demoSale", amount: gift.price, title: "Демо-продажа подарка", balanceAfter: state.fakeStarsBalance),
+                at: 0
+            )
+            transaction.updatePreferencesEntry(key: storageKey, { _ in PreferencesEntry(state) })
+            return true
+        }
+    }
+}
+

