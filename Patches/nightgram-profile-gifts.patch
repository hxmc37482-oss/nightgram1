+import SwiftUI
+import AccountContext
+import SwiftSignalKit
+
+private final class NightGramLocalGiftGalleryModel: ObservableObject {
+    @Published private(set) var state = NightGramLocalGiftState()
+    @Published private(set) var statusText = "LOCAL DEMO"
+
+    private let postbox: Postbox
+    private let disposables = DisposableSet()
+
+    init(context: AccountContext) {
+        self.postbox = context.account.postbox
+        let stateDisposable = (NightGramLocalGiftStore.stateSignal(postbox: self.postbox)
+        |> deliverOnMainQueue).startStrict(next: { [weak self] state in
+            self?.state = state
+        })
+        self.disposables.add(stateDisposable)
+    }
+
+    deinit {
+        self.disposables.dispose()
+    }
+
+    func addGift(received: Bool) {
+        let disposable = (NightGramLocalGiftStore.addDemoGift(
+            postbox: self.postbox,
+            title: received ? "Gift received (demo)" : "Rose",
+            symbol: received ? "🎁" : "🌹",
+            price: 100,
+            received: received
+        )
+        |> deliverOnMainQueue).startStrict(next: { [weak self] success in
+            self?.statusText = success ? "LOCAL DEMO · saved on this device" : "Not enough demo Stars"
+        })
+        self.disposables.add(disposable)
+    }
+
+    func pin(_ gift: NightGramLocalGift) {
+        let disposable = NightGramLocalGiftStore.setPinned(postbox: self.postbox, id: gift.id, pinned: !gift.isPinned).start()
+        self.disposables.add(disposable)
+    }
+
+    func hide(_ gift: NightGramLocalGift) {
+        let disposable = NightGramLocalGiftStore.setHidden(postbox: self.postbox, id: gift.id, hidden: !gift.isHidden).start()
+        self.disposables.add(disposable)
+    }
+
+    func sell(_ gift: NightGramLocalGift) {
+        let disposable = NightGramLocalGiftStore.sellDemoGift(postbox: self.postbox, id: gift.id).start()
+        self.disposables.add(disposable)
+    }
+}
+
+public struct NightGramLocalGiftGalleryView: View {
+    @StateObject private var model: NightGramLocalGiftGalleryModel
+
+    public init(context: AccountContext) {
+        _model = StateObject(wrappedValue: NightGramLocalGiftGalleryModel(context: context))
+    }
+
+    public var body: some View {
+        List {
+            Section {
+                HStack {
+                    Label("\(model.state.fakeStarsBalance) demo Stars", systemImage: "star.fill")
+                    Spacer()
+                    Text("LOCAL")
+                        .font(.caption2.weight(.bold))
+                        .foregroundStyle(.orange)
+                }
+                Text("This balance is stored in this account's local Postbox. It is not Telegram Stars and cannot be spent or transferred.")
+                    .font(.footnote)
+                    .foregroundStyle(.secondary)
+                Text(model.statusText)
+                    .font(.caption2.weight(.semibold))
+                    .foregroundStyle(.secondary)
+            } header: {
+                Text("Local demo balance")
+            }
+
+            Section {
+                Button {
+                    model.addGift(received: false)
+                } label: {
+                    Label("Buy a demo gift · −100 Stars", systemImage: "gift.fill")
+                }
+                Button {
+                    model.addGift(received: true)
+                } label: {
+                    Label("Add “Gift to me” demo · +100 Stars", systemImage: "gift")
+                }
+            } header: {
+                Text("Demo actions")
+            }
+
+            Section {
+                let visibleGifts = model.state.gifts
+                    .filter { !$0.isHidden && $0.soldAt == nil }
+                    .sorted {
+                        if $0.isPinned != $1.isPinned { return $0.isPinned }
+                        return $0.createdAt > $1.createdAt
+                    }
+
+                if visibleGifts.isEmpty {
+                    Text("No local demo gifts yet")
+                        .foregroundStyle(.secondary)
+                } else {
+                    ForEach(visibleGifts) { gift in
+                        VStack(alignment: .leading, spacing: 8) {
+                            HStack(spacing: 12) {
+                                Text(gift.symbol).font(.largeTitle)
+                                VStack(alignment: .leading, spacing: 3) {
+                                    Text(gift.title).font(.headline)
+                                    Text(gift.isReceived ? "Received locally · demo" : "Purchased locally · demo")
+                                        .font(.caption)
+                                        .foregroundStyle(.secondary)
+                                }
+                                Spacer()
+                                if gift.isPinned {
+                                    Image(systemName: "pin.fill").foregroundStyle(.orange)
+                                }
+                            }
+                            HStack {
+                                Button(gift.isPinned ? "Unpin" : "Pin") { model.pin(gift) }
+                                Button("Hide") { model.hide(gift) }
+                                Button("Sell demo") { model.sell(gift) }
+                            }
+                            .font(.caption)
+                        }
+                        .padding(.vertical, 4)
+                    }
+                }
+            } header: {
+                Text("My local gifts")
+            }
+
+            Section {
+                Text("All gifts, balances and operations shown here are local previews. Nothing is sent to chats or other users, and Telegram's real gift inventory, Stars balance and transaction history are untouched.")
+                    .font(.footnote)
+                    .foregroundStyle(.secondary)
+            }
+        }
+        .navigationTitle("Local demo gifts")
+        .navigationBarTitleDisplayMode(.inline)
+    }
+}
+
