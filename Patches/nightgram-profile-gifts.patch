+import UIKit
+import Display
+import AsyncDisplayKit
+import AccountContext
+
+/// A Telegram-native controller that hosts the NightGram SwiftUI panel.
+private final class NightGramPanelController: ViewController {
+    private let context: AccountContext
+    private var hostingController: UIHostingController<NightGramPanel>?
+
+    init(context: AccountContext) {
+        self.context = context
+        super.init(navigationBarPresentationData: nil)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) is not supported")
+    }
+
+    override func loadDisplayNode() {
+        super.loadDisplayNode()
+
+        let hostingController = UIHostingController(rootView: NightGramPanel(context: self.context))
+        self.hostingController = hostingController
+        self.addChild(hostingController)
+        hostingController.view.backgroundColor = .clear
+        hostingController.view.frame = self.displayNode.view.bounds
+        hostingController.view.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        self.displayNode.view.addSubview(hostingController.view)
+        hostingController.didMove(toParent: self)
+    }
+}
+
+/// Creates the NightGram panel with access to the current account's local Postbox.
+public func makeNightGramPanelController(context: AccountContext) -> ViewController {
+    return NightGramPanelController(context: context)
+}
+

